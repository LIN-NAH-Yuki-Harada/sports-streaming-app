# /opt/archive-worker/.env （chmod 600・gitに入れない・値は Vercel env からコピー）
#
# ★このファイルは worker.js が実際に読む env を網羅している。
#   worker.js は git 管理外の手デプロイだった時期があり、本番だけで有効化された機能の
#   env がここに載っていなかった（2026-08-05 に本番版を取り込んで同期）。
#   worker.js に env を足したら、必ずここにも書くこと。

# ── 必須 ──────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
RECORDINGS_DIR=/var/recordings

# ── 画質・変換 ─────────────────────────────────────────
# 中間ファイルの CRF（小さいほど高画質・大きいほど軽い）
CRF_INTERMEDIATE=17
# YouTube へ上げる最終ファイルの CRF
CRF_FINAL=20
# これ未満の尺はアーカイブしない（秒・上限60にクランプ）。テスト配信は60秒以上にすること
MIN_ARCHIVE_SEC=30
# 720p を 1080p へ拡大する（"1" で有効）。★画質レバーとして**最も効く**。
# 【なぜ効くのか】YouTube は解像度ティアごとに割当ビットレートを変えており、
#   720pティア≒0.7Mbps に対し 1080pティア≒1.2Mbps（約1.7倍）。720p由来を拡大した1080pは
#   エンコーダにとって「安い」画素なので、増えた枠がそのままディテール保持に回る。
#   実測: 視聴者に届く画質が VMAF 75 → 85（+9.5〜14.8）。6ポイントで体感差が出る領域。
# 【コスト】正規化パスが約2.3倍。90分試合1本で +30分前後。
#   ★大会日6試合のシミュレーションで、最終試合終了+89分で全完了することを確認済み。
# 【安全弁】worker.js は「入力が正確に 1280x720 と実測できたときだけ」拡大する。
UPSCALE_1080=1

# アーカイブ音声のビットレート（既定 192k）。
# ★それまで -b:a を1箇所も指定しておらず ffmpeg 既定の 128k のまま、
#   端末128k → 焼き込み128k → 正規化128k → YouTube で Opus、と**同レートのAAC再エンコードを
#   3世代**通していた。体育館の残響＋歓声はAACが最も苦手な信号。CPU 増は 1% 未満。
AUDIO_BITRATE=192k
# ffmpeg のスレッド数。空なら ffmpeg の自動判定
FFMPEG_THREADS=
# 中間生成物の置き場（既定 /var/tmp）。★tmpfs だと長尺で溢れるので実ディスクを指すこと
WORK_DIR=/var/tmp

# 実映像がこの秒数を超えたら 1080p 拡大を見送る（既定 6000 = 100分）。
# 拡大ありの最終正規化は実時間の約1.7倍かかる。3時間級の試合だと合計が
# TimeoutStartSec(3h) に対して余裕12分しか無くなるため、**画質より完走を優先**する安全弁。
# 0 や空にすると既定値(6000)が使われる。実質無効化したいなら極端に大きい値を入れる。
UPSCALE_MAX_SEC=6000

# ── 連結（concat）のメモリ設計 ──────────────────────────
# 2026-08-12: 66分の試合(有効131セグメント)が5回連続で失敗した。旧実装は**全セグメントを
# 一度に ffmpeg へ入力**して連結中に正規化していたため、メモリ・CPU がセグメント本数に
# 比例した（実測 load average 176 / RSS 1.2GB + swap 1.9GB / 2時間37分かけて OOM）。
# 現在は「1本ずつ正規形に揃える → 連結は -c copy」に変え、本数に依存しなくなっている。
#
# ★どちらも通常は変更不要。本番で問題が出たときのロールバック用スイッチ。
# "0" で連結の -c copy を止める（1本ずつ正規化 + 分割 filter_complex にフォールバック）
CONCAT_COPY_ENABLED=1
# "0" でセグメント前段の正規化を止め、旧 burnScoreboard 相当の挙動に戻す
# （連結側は分割 filter_complex になるので、メモリ対策自体は維持される）
SEGMENT_NORMALIZE_ENABLED=1
# フォールバックで filter_complex 連結に落ちたときの1回あたり入力本数（既定8）。
# 実測ピークRSS: 8入力=388MB / 20入力=574MB / 60入力=995MB。MemoryHigh=1200M に収めるため小さく保つ
CONCAT_CHUNK=8
# 「旧実装そのまま(全入力を一度に filter_complex)」を最終手段として試してよい上限本数（既定12）。
# これを超えると OOM が確実なので試さず失敗させる（壊れた動画を上げない fail-closed）
CONCAT_FULL_FC_MAX=12

# ── アーカイブされない録画の即時削除（既定ON）──────────
# MediaMTX はプランに関係なく全配信を録画するが、アーカイブ対象外（¥300/無料/YouTube未連携）や
# 短すぎる配信の録画は一度も使われないまま recordDeleteAfter(48h) を待って消えるだけだった。
# 実測（2026-07-22〜08-06 の92本）: 58%(53本)が対象外・15日間で 23.1GB が無駄に通過。
# "0" にすると従来どおり48h保持に戻る（ロールバック用）。
DROP_UNARCHIVED_RECORDINGS=1
# ★安全弁: 直近この時間内に書き込みがあったファイルは削除しない（既定 10分 = 600000）。
# /api/cron/cleanup は心拍を打たないアプリ配信を「開始から2時間」で ended にするため、
# **まだ配信中の行**がワーカーに来ることがある。その録画を消すと進行中の試合が失われる。
DROP_MIN_IDLE_MS=600000

# ── 処理順（短い配信を優先）───────────────────────────
# ワーカーは1tickにつき1本しか処理しない。「終了が古い順」だと**長い配信1本が
# 後続の全員を何時間も塞ぐ**（2026-08-08 実測: 1時間42分の変換が57分かかり、
# その裏で67秒の配信が40分近く待たされた）。候補を複数取って**尺の短い順**に処理する。
# 一度に取得する候補数（この中から最短のものを選ぶ）
QUEUE_LOOKAHEAD=10
# ★飢餓防止: 終了からこの時間を超えて待っている配信は、尺に関係なく最優先（既定3時間）。
# これが無いと、短い配信が次々来たときに長い配信が永久に後回しになる。
ARCHIVE_STARVATION_MS=10800000

# ── ライブ並走バックオフ（"1" で有効）──────────────────
# 配信中は重い変換を後回しにして、ライブのディスクIO/CPUを守る
LIVE_BACKOFF_ENABLED=1
# 後回しにし続ける上限（既定 45分 = 2700000）。超えたらライブ中でも処理する
LIVE_BACKOFF_MAX_DEFER_MS=2700000
# 「ライブ中」とみなす started_at の上限（既定 3時間 = 10800000）。
# ゴーストを永久にライブ扱いして変換が止まるのを防ぐ
LIVE_ACTIVE_MAX_AGE_MS=10800000

# ── ゴースト掃除（"1" で有効）──────────────────────────
# MediaMTX に実体が無いのに status=live のまま残った行を終了させる
GHOST_SWEEP_ENABLED=1
# 掃除の実行間隔（既定 20分 = 1200000）
GHOST_SWEEP_INTERVAL_MS=1200000
# 開始からこの時間が経った行だけを対象にする（既定 10分 = 600000・開始直後の誤爆防止）
GHOST_MIN_AGE_MS=600000
# MediaMTX の API。ゴースト判定の実体照合に使う
MEDIAMTX_API_BASE=http://127.0.0.1:9997

# ── サーバー稼働メトリクス（"1" で有効）─────────────────
# tick 毎に CPU/メモリ/ディスク/帯域を Supabase の server_metrics へ push。
# admin の「サーバー」タブがこれを読む
METRICS_ENABLED=1
