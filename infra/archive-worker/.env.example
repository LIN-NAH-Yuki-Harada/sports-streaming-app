# /opt/archive-worker/.env （chmod 600・gitに入れない・値は Vercel env からコピー）
#
# ★このファイルは worker.js が実際に読む env を網羅している。
#   worker.js は git 管理外の手デプロイだった時期があり、本番だけで有効化された機能の
#   env がここに載っていなかった（2026-08-05 に本番版を取り込んで同期）。
#   worker.js に env を足したら、必ずここにも書くこと。

# ── 必須 ──────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
RECORDINGS_DIR=/var/recordings

# ── 画質・変換 ─────────────────────────────────────────
# 中間ファイルの CRF（小さいほど高画質・大きいほど軽い）
CRF_INTERMEDIATE=17
# YouTube へ上げる最終ファイルの CRF
CRF_FINAL=20
# これ未満の尺はアーカイブしない（秒・上限60にクランプ）。テスト配信は60秒以上にすること
MIN_ARCHIVE_SEC=30
# 720p を 1080p へ拡大する（"1" で有効）。★画質レバーとして最も効くが CPU も食う。既定OFF
UPSCALE_1080=
# ffmpeg のスレッド数。空なら ffmpeg の自動判定
FFMPEG_THREADS=
# 中間生成物の置き場（既定 /var/tmp）。★tmpfs だと長尺で溢れるので実ディスクを指すこと
WORK_DIR=/var/tmp

# ── アーカイブされない録画の即時削除（既定ON）──────────
# MediaMTX はプランに関係なく全配信を録画するが、アーカイブ対象外（¥300/無料/YouTube未連携）や
# 短すぎる配信の録画は一度も使われないまま recordDeleteAfter(48h) を待って消えるだけだった。
# 実測（2026-07-22〜08-06 の92本）: 58%(53本)が対象外・15日間で 23.1GB が無駄に通過。
# "0" にすると従来どおり48h保持に戻る（ロールバック用）。
DROP_UNARCHIVED_RECORDINGS=1
# ★安全弁: 直近この時間内に書き込みがあったファイルは削除しない（既定 10分 = 600000）。
# /api/cron/cleanup は心拍を打たないアプリ配信を「開始から2時間」で ended にするため、
# **まだ配信中の行**がワーカーに来ることがある。その録画を消すと進行中の試合が失われる。
DROP_MIN_IDLE_MS=600000

# ── ライブ並走バックオフ（"1" で有効）──────────────────
# 配信中は重い変換を後回しにして、ライブのディスクIO/CPUを守る
LIVE_BACKOFF_ENABLED=1
# 後回しにし続ける上限（既定 45分 = 2700000）。超えたらライブ中でも処理する
LIVE_BACKOFF_MAX_DEFER_MS=2700000
# 「ライブ中」とみなす started_at の上限（既定 3時間 = 10800000）。
# ゴーストを永久にライブ扱いして変換が止まるのを防ぐ
LIVE_ACTIVE_MAX_AGE_MS=10800000

# ── ゴースト掃除（"1" で有効）──────────────────────────
# MediaMTX に実体が無いのに status=live のまま残った行を終了させる
GHOST_SWEEP_ENABLED=1
# 掃除の実行間隔（既定 20分 = 1200000）
GHOST_SWEEP_INTERVAL_MS=1200000
# 開始からこの時間が経った行だけを対象にする（既定 10分 = 600000・開始直後の誤爆防止）
GHOST_MIN_AGE_MS=600000
# MediaMTX の API。ゴースト判定の実体照合に使う
MEDIAMTX_API_BASE=http://127.0.0.1:9997

# ── サーバー稼働メトリクス（"1" で有効）─────────────────
# tick 毎に CPU/メモリ/ディスク/帯域を Supabase の server_metrics へ push。
# admin の「サーバー」タブがこれを読む
METRICS_ENABLED=1
