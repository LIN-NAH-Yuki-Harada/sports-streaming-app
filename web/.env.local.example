# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LiveKit
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Stripe（テスト環境）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_STREAMER=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# YouTube Data API（チームプラン向けアーカイブ連携）
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Storage (S3互換) — LiveKit Egress 録画MP4の一時保存先
# Supabase Dashboard > Project Settings > API > S3 Connection で取得
SUPABASE_S3_ACCESS_KEY=your-s3-access-key
SUPABASE_S3_SECRET_KEY=your-s3-secret-key
SUPABASE_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-northeast-1
SUPABASE_STORAGE_RECORDINGS_BUCKET=recordings

# LiveKit Egress Webhook（Egress 完了時に Vercel 側に通知）
LIVEKIT_WEBHOOK_KEY=your-livekit-webhook-key

# Vercel Cron（stale配信の定期クリーンアップ用）
CRON_SECRET=your-cron-secret

# Resend（お問い合わせフォームのメール通知）
# https://resend.com/api-keys で発行
RESEND_API_KEY=re_your_resend_api_key
# 管理者通知メールの受信先
CONTACT_NOTIFICATION_EMAIL=admin@example.com
# 障害アラート（cron/alerts・cron/trial-enforce の安全装置作動）の受信先。
# 未設定なら CONTACT_NOTIFICATION_EMAIL にフォールバックする。
ALERT_NOTIFICATION_EMAIL=admin@example.com

# 自前配信サーバー（MediaMTX on VPS）
# STREAM_HOST は publish(RTMP) と cron/no-video のプローブ先（オリジン直）。
# STREAM_PLAYBACK_HOST を設定すると視聴(HLS)だけ CDN(CloudFront)へ逃がせる。
NEXT_PUBLIC_STREAM_SELFHOST=false
STREAM_HOST=live.example.com
STREAM_PLAYBACK_HOST=
STREAM_PUBLISH_USER=spotch
STREAM_PUBLISH_SECRET=your-mediamtx-publish-secret

# ============================================
# 無料プラン10分制限のサーバー側強制（cron/trial-enforce）
# ============================================
# off（既定・何もしない） / dry（対象を数えてログに出すだけ） / on（実際に配信を終了させる）
# ★ 誤爆すると課金ユーザーの試合が止まる。必ず off → dry で数日観測 → on の順で上げること。
TRIAL_ENFORCE_MODE=off
# cron のジッタと端末・サーバーの時計ずれを吸収する猶予（秒）。短くしないこと。
TRIAL_ENFORCE_GRACE_SEC=120
# 1分間に停止してよい上限。超えた tick は1本も停止せずオーナーに通報だけする（安全装置）。
TRIAL_ENFORCE_MAX_PER_TICK=3
# 課金痕跡（Stripe サブスクID / Apple original_transaction_id）があれば絶対に停止しない。
TRIAL_ENFORCE_SKIP_EVER_PAID=true
# プラン反映待ち（webhook 遅延）の猶予（ミリ秒）。既定10分。
TRIAL_ENFORCE_PLAN_SETTLE_MS=600000

# ============================================
# 「見えていない配信」検知（cron/no-video）
# ============================================
# off にすると何もしない。既定（未設定）は有効。書き込むのは broadcasts.live_error と
# alert_log だけで、配信・視聴・課金には一切影響しない。
NO_VIDEO_PROBE=on
# 「DBは配信中なのに配信サーバーに何も届いていない（HLSが404）」の検知だけを個別に
# 黙らせるスイッチ。4G の長時間断で鳴りすぎる場合に off にする（no_video 判定は残る）。
NO_STREAM_PROBE=on
